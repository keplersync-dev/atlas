{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas",
  "identifier": "dev.keplerhaloxx.atlas",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Atlas",
        "minWidth": 1050,
        "minHeight": 650,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#101216"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost https://cdn.modrinth.com https://media.forgecdn.net https://cdn.discordapp.com https://textures.minecraft.net",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/cache/icons/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "atlas"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFMEJCMjI0N0FDNjc3MkYKUldRdmQ4WjZKTElMZnBkVG1kbEVyWjBwRHFTUFAzdHVVRWUxd2pwZjBDTXRJRnFRM3czUnpRdHoK",
      "endpoints": [
        "https://github.com/xhalo-dev/atlas/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
